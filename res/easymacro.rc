#include <windows.h>

1 ICON "app.ico"
2 ICON "paused.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "EasyMacro"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "EasyMacro"
            VALUE "OriginalFilename", "EasyMacro.exe"
            VALUE "ProductName", "EasyMacro"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
